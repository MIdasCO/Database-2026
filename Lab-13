SELECT COUNT(DISTINCT faculty_id) AS represented_faculties,
       SUM(salary) AS total_salaries,
       ROUND(AVG(salary), 2) AS average_salary,
       MIN(salary) AS lowest_salary,
       MAX(salary) AS highest_salary
FROM instructors;
